{
  "name": "dsh-auto-research-executor-local",
  "version": "0.3.0",
  "description": "Runs dsh-auto-research commands in the batch's LayerFS Sandbox",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["lib", "src"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dsh-auto-research-api": "workspace:*"
  },
  "license": "MIT"
}
