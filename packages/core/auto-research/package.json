{
  "name": "dsh-auto-research",
  "version": "0.3.0",
  "description": "Research batches on LayerFS branches as a DeepSeek Harness SubagentProvider: explore forks, continue resumes the leader's own worker session",
  "icon": "./icon.svg",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "lib",
    "src",
    "icon.svg",
    "cordis.patch.yml",
    "locale"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dsh-auto-research-api": "workspace:*",
    "dsh-auto-research-workspace-layerfs": "workspace:*",
    "dsh-auto-research-coordinator": "workspace:*",
    "dsh-auto-research-worker": "workspace:*",
    "dsh-auto-research-executor-colab": "workspace:*"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "subagent",
    "research",
    "rsi-top",
    "fork-and-flush",
    "layerfs",
    "auto-research"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-alpha.4 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
